# Copie este arquivo para .env e preencha (nunca commite .env)

PORT=3000

# Para onde as mensagens do formulário serão enviadas
MAIL_TO=seu_email@gmail.com

# Remetente exibido (pode ser igual ao SMTP_USER)
MAIL_FROM=Site NJR10 <seu_email@gmail.com>

# SMTP — exemplo Gmail: use "Senha de app" em https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=seu_email@gmail.com
SMTP_PASS=sua_senha_de_app

# Opcional: limite de envios por IP (padrão 8 a cada 15 min)
# RATE_LIMIT_MAX=8
